    "@issuer/database": "workspace:*",
    "@issuer/shared": "workspace:*",
    "hono": "^4.13.14",
    "uuid": "^14.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "rolldown": "^1.2.16",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
